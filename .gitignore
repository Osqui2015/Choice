# ====================================================
#  Choice - .gitignore para producción
# ====================================================

# ---- Environment & secrets ----
.env
.env.backup
.env.production
auth.json

# ---- Dependencies ----
/node_modules
/vendor

# ---- Build artifacts (se regeneran con npm run build / php artisan) ----
/public/build
/public/hot
/public/storage
/public/sw.js
/public/workbox-*.js
/public/favicon.ico.bak

# ---- Laravel runtime ----
/storage/*.key
/storage/pail
/storage/app/import_state.json
/storage/app/private
/storage/app/public
/storage/framework/cache/data
/storage/framework/sessions
/storage/framework/views
/storage/framework/testing
/storage/logs/*.log
/storage/debugbar

# ---- IDEs & editores ----
/.fleet
/.idea
/.nova
/.phpunit.cache
/.vscode
/.zed
Homestead.json
Homestead.yaml
Thumbs.db
.DS_Store
*.swp
*.swo

# ---- Tests & debug (no producción) ----
/_archive
/test_tmp
/test_*.php
/test_*.ps1
/test_*.json
/inspect_*.php
/verify_*.php
/tests/coverage

# ---- Data sources (archivos fuente de import) ----
# Por defecto los xlsx NO se commitean (son binarios pesados)
*.xlsx
*.xls
*.csv
~$*
# Pero el banco de preguntas en database/imports/ SÍ va (necesario para producción)
!database/imports/*.xlsx
!database/imports/*.xls

# ---- Misc ----
*.log
.phpactor.json
.phpunit.result.cache
